[41.677, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00memail\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mparsed.data.email.toLowerCase().trim();\u001b[90m\u001b[39;49;00m\n"]
[41.732, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mheaderStore\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94mawait\u001b[39;49;00m\u001b[90m \u001b[39;49;00mheaders();\u001b[90m\u001b[39;49;00m\n"]
[41.787, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mip\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mgetClientIpFromHeaders(headerStore);\u001b[90m\u001b[39;49;00m\n"]
[41.842, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mbyEmail\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mrateLimit(\u001b[33m`\u001b[39;49;00m\u001b[33mweb-login:\u001b[39;49;00m\u001b[33m${\u001b[39;49;00memail\u001b[33m}\u001b[39;49;00m\u001b[33m`\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94m8\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94m60\u001b[39;49;00m_000);\u001b[90m\u001b[39;49;00m\n"]
[41.897, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00mbyIp\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00mrateLimit(\u001b[33m`\u001b[39;49;00m\u001b[33mweb-login-ip:\u001b[39;49;00m\u001b[33m${\u001b[39;49;00mip\u001b[33m}\u001b[39;49;00m\u001b[33m`\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94m20\u001b[39;49;00m,\u001b[90m \u001b[39;49;00m\u001b[94m60\u001b[39;49;00m_000);\u001b[90m\u001b[39;49;00m\n"]
[41.952, "o", "\u001b[90m  77\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!byEmail.ok\u001b[90m \u001b[39;49;00m||\u001b[90m \u001b[39;49;00m!byIp.ok)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[42.007, "o", "\u001b[90m  78\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mreturn\u001b[39;49;00m\u001b[90m \u001b[39;49;00m{\u001b[90m \u001b[39;49;00merror:\u001b[90m \u001b[39;49;00m\u001b[33m\"Demasiados intentos. Espera un minuto.\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00m};\u001b[90m\u001b[39;49;00m\n"]
