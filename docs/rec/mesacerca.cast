[176.974, "o", "\u001b[90m  21\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mexport\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94masync\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[94mfunction\u001b[39;49;00m\u001b[90m \u001b[39;49;00mstartKycAction()\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[177.029, "o", "\u001b[90m  22\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mconst\u001b[39;49;00m\u001b[90m \u001b[39;49;00msession\u001b[90m \u001b[39;49;00m=\u001b[90m \u001b[39;49;00m\u001b[94mawait\u001b[39;49;00m\u001b[90m \u001b[39;49;00mgetSession();\u001b[90m\u001b[39;49;00m\n"]
[177.084, "o", "\u001b[90m  23\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(!session)\u001b[90m \u001b[39;49;00mredirect(\u001b[33m\"/login?next=/kyc\"\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
[177.139, "o", "\u001b[90m  24\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mif\u001b[39;49;00m\u001b[90m \u001b[39;49;00m(session.role\u001b[90m \u001b[39;49;00m!==\u001b[90m \u001b[39;49;00m\u001b[33m\"MERCHANT\"\u001b[39;49;00m\u001b[90m \u001b[39;49;00m&&\u001b[90m \u001b[39;49;00msession.role\u001b[90m \u001b[39;49;00m!==\u001b[90m \u001b[39;49;00m\u001b[33m\"COURIER\"\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m{\u001b[90m\u001b[39;49;00m\n"]
[177.194, "o", "\u001b[90m  25\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00mredirect(\u001b[33m\"/\"\u001b[39;49;00m);\u001b[90m\u001b[39;49;00m\n"]
